# Add these in Vercel Project Settings > Environment Variables (and local .env)
# Never commit real values to source control.
SESSION_SECRET="at-least-32-random-characters-use-64-or-more"
ADMIN_PASSWORD="your-initial-admin-password"

# Resend Email Service (Recommended - 3,000 free emails/month, no dashboard templates needed)
RESEND_API_KEY="re_123456789"
# Optional custom sender (defaults to HassanEditz Security <onboarding@resend.dev>)
# RESEND_FROM_EMAIL="security@yourdomain.com"

# Upstash Redis for storing content and security sessions
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-secret-token"

# EmailJS (Used by the client Contact Form)
EMAILJS_SERVICE_ID="service_1t3blmm"
EMAILJS_ADMIN_TEMPLATE_ID="template_zqki0tz"
EMAILJS_PUBLIC_KEY="Q6SDatIdkncwKll8h"
